class Solution {
public:
    int minCost(vector<int>& startPos, vector<int>& homePos,
                vector<int>& rowCosts, vector<int>& colCosts) {
        int r0 = startPos[0], c0 = startPos[1];
        int r1 = homePos[0], c1 = homePos[1];
        int cost = 0;
        if (r0 < r1) {
            for (int i = r0; i < r1; i++) {
                cost += rowCosts[i + 1];
            }
        } else if (r0 > r1) {
            for (int i = r0; i > r1; i--) {
                cost += rowCosts[i - 1];
            }
        }
        if (c0 < c1) {
            for (int i = c0; i < c1; i++) {
                cost += colCosts[i + 1];
            }
        } else if (c0 > c1) {
            for (int i = c0; i > c1; i--) {
                cost += colCosts[i - 1];
            }
        }
        return cost;
    }
};
