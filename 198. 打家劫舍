class Solution {
public:
    int rob(vector<int>& nums) {
        int n=nums.size();
        if(n==0){
            return 0;
        }else if(n==1){
            return nums[0];
        }
        int* maxsteal=new int [n];
        maxsteal[0]=nums[0];
        maxsteal[1]=max(nums[0],nums[1]);
        for(int i=2;i<n;i++){
            maxsteal[i]=max(nums[i]+maxsteal[i-2],maxsteal[i-1]);
        }
        int maxnums=maxsteal[n-1];
        delete[]maxsteal;
        return maxnums;
    }
};
