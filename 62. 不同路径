class Solution {
public:
    int uniquePaths(int m, int n) {
        vector<vector<int>> troop(m,vector<int>(n));
        for(int i=0;i<m;i++){
            troop[i][0]=1;
        }
        for(int j=0;j<n;j++){
            troop[0][j]=1;
        }
        for(int i=1;i<m;i++){
            for(int j=1;j<n;j++){
                troop[i][j]=troop[i-1][j]+troop[i][j-1];
            }
        }
        return troop[m-1][n-1];
    }
};
